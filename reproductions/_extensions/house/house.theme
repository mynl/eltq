{
    "text-color": "#1a1a1a",
    "background-color": "#f6f6f6",
    "line-number-color": "#8a8f99",
    "line-number-background-color": null,
    "text-styles": {
        "Keyword":        { "text-color": "#1f4e8a", "background-color": null, "bold": true,  "italic": false, "underline": false },
        "ControlFlow":    { "text-color": "#1f4e8a", "background-color": null, "bold": true,  "italic": false, "underline": false },
        "Import":         { "text-color": "#1f4e8a", "background-color": null, "bold": true,  "italic": false, "underline": false },
        "Variable":       { "text-color": "#1f4e8a", "background-color": null, "bold": false, "italic": false, "underline": false },
        "Function":       { "text-color": "#6a3eaf", "background-color": null, "bold": false, "italic": false, "underline": false },
        "BuiltIn":        { "text-color": "#6a3eaf", "background-color": null, "bold": false, "italic": false, "underline": false },
        "Attribute":      { "text-color": "#6a3eaf", "background-color": null, "bold": false, "italic": false, "underline": false },
        "DecVal":         { "text-color": "#b87333", "background-color": null, "bold": false, "italic": false, "underline": false },
        "BaseN":          { "text-color": "#b87333", "background-color": null, "bold": false, "italic": false, "underline": false },
        "Float":          { "text-color": "#b87333", "background-color": null, "bold": false, "italic": false, "underline": false },
        "Constant":       { "text-color": "#b87333", "background-color": null, "bold": false, "italic": false, "underline": false },
        "Char":           { "text-color": "#2e7d32", "background-color": null, "bold": false, "italic": false, "underline": false },
        "String":         { "text-color": "#2e7d32", "background-color": null, "bold": false, "italic": false, "underline": false },
        "VerbatimString": { "text-color": "#2e7d32", "background-color": null, "bold": false, "italic": false, "underline": false },
        "SpecialString":  { "text-color": "#2e7d32", "background-color": null, "bold": false, "italic": false, "underline": false },
        "SpecialChar":    { "text-color": "#2e7d32", "background-color": null, "bold": false, "italic": false, "underline": false },
        "Comment":        { "text-color": "#8a8f99", "background-color": null, "bold": false, "italic": true,  "underline": false },
        "Documentation":  { "text-color": "#8a8f99", "background-color": null, "bold": false, "italic": true,  "underline": false },
        "CommentVar":     { "text-color": "#8a8f99", "background-color": null, "bold": false, "italic": true,  "underline": false },
        "Annotation":     { "text-color": "#8a8f99", "background-color": null, "bold": false, "italic": true,  "underline": false },
        "Operator":       { "text-color": "#555555", "background-color": null, "bold": false, "italic": false, "underline": false },
        "DataType":       { "text-color": "#1a1a1a", "background-color": null, "bold": false, "italic": false, "underline": false },
        "Other":          { "text-color": "#1a1a1a", "background-color": null, "bold": false, "italic": false, "underline": false },
        "Extension":      { "text-color": "#1a1a1a", "background-color": null, "bold": false, "italic": false, "underline": false },
        "Preprocessor":   { "text-color": "#1a1a1a", "background-color": null, "bold": false, "italic": false, "underline": false },
        "RegionMarker":   { "text-color": "#1a1a1a", "background-color": null, "bold": false, "italic": false, "underline": false },
        "Information":    { "text-color": "#8a8f99", "background-color": null, "bold": false, "italic": true,  "underline": false },
        "Warning":        { "text-color": "#8a8f99", "background-color": null, "bold": false, "italic": true,  "underline": false },
